# Database — defaults to a local SQLite file (file:./data/boujee.db).
# For production, point at a Turso/libsql instance:
# DATABASE_URL=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/boujee.db

# Set to 1 to seed demo pros/users/bookings on an empty database (dev convenience).
# Leave unset in production for a clean launch.
SEED_DEMO=1
